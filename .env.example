# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Quala VMS Server Configuration
NODE_ENV=development
PORT=3000
API_PORT=3000
MONGO_URI=mongodb://127.0.0.1:27017/qualavms
JWT_SECRET=quala_vms_jwt_secure_secret_key_change_me
JWT_EXPIRES=7d
VM_DIR=/var/lib/qualavms/vms
AUTO_SSH_PORT_MIN=25501
AUTO_SSH_PORT_MAX=25600
AUTO_VNC_PORT_MIN=25901
AUTO_VNC_PORT_MAX=26000
LOG_LEVEL=info
DEMO_MODE=true

